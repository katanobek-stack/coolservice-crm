{
  "name": "coolservice-crm-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "build:test:appointments": "node node_modules/esbuild/bin/esbuild tests/firestore.appointments.test.ts --bundle --packages=external --platform=node --format=esm --outfile=.test-dist/firestore.appointments.test.mjs",
    "test:appointments": "npm run build:test:appointments && node --test .test-dist/firestore.appointments.test.mjs",
    "build:test:concurrency": "node node_modules/esbuild/bin/esbuild tests/firestore.concurrency.test.ts --bundle --packages=external --platform=node --format=esm --outfile=.test-dist/firestore.concurrency.test.mjs",
    "test:concurrency": "npm run build:test:concurrency && node --test .test-dist/firestore.concurrency.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react-router-dom": "^5.3.3",
    "firebase": "^12.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.16.0",
    "tailwindcss": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
