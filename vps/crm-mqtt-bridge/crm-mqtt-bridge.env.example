# Copy to /etc/crm-mqtt-bridge/bridge.env. Do not put real keys in Git.
CRM_MQTT_HOST=mqtt.example.invalid
CRM_MQTT_PORT=8883
CRM_MQTT_TLS=true
CRM_MQTT_USERNAME=
CRM_MQTT_PASSWORD_FILE=/etc/crm-mqtt-bridge/mqtt-password
CRM_MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt
CRM_MQTT_CLIENT_ID=crm-mqtt-bridge

# Existing HTTPS function endpoint. Keep the current production value on VPS.
CRM_TELEMETRY_URL=https://europe-west1-example.cloudfunctions.net/ingestTelemetry
# New endpoint. Set the deployed production ingestControllerStatus URL only on VPS.
CRM_STATUS_URL=https://europe-west1-example.cloudfunctions.net/ingestControllerStatus

# Root-readable JSON map of device IDs to existing device keys; never commit it.
CRM_DEVICE_KEYS_FILE=/etc/crm-mqtt-bridge/device-keys.json
CRM_QUEUE_DB=/var/lib/crm-mqtt-bridge/queue.sqlite3
CRM_LOG_LEVEL=INFO
