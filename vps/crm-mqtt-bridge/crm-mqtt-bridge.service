[Unit]
Description=Coolservice CRM MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crm-mqtt-bridge
Group=crm-mqtt-bridge
EnvironmentFile=/etc/crm-mqtt-bridge/bridge.env
WorkingDirectory=/opt/crm-mqtt-bridge
ExecStart=/opt/crm-mqtt-bridge/venv/bin/python /opt/crm-mqtt-bridge/crm_mqtt_bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/crm-mqtt-bridge

[Install]
WantedBy=multi-user.target
