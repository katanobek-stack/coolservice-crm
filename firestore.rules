rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function staffPath(userId) {
      return /databases/$(database)/documents/staff/$(userId);
    }

    function hasStaffProfile() {
      return isAuth() && exists(staffPath(request.auth.uid));
    }

    function hasStoredRole(role) {
      return hasStaffProfile()
        && get(staffPath(request.auth.uid)).data.role == role;
    }

    function isOwner() {
      return isAuth()
        && (("role" in request.auth.token && request.auth.token.role == "owner")
          || hasStoredRole("owner"));
    }

    function isAdmin() {
      return hasStoredRole("admin");
    }

    function isManager() {
      return hasStoredRole("manager");
    }

    function isAdminOrOwner() {
      return isOwner() || isAdmin();
    }

    match /ppzTasks/{taskId} {
      allow read: if isAdminOrOwner()
        || (hasStaffProfile() && request.auth.uid in resource.data.assignees);
      allow write: if false;
    }

    match /workEvents/{eventId} {
      allow read: if isAdminOrOwner()
        || (hasStaffProfile() && request.auth.uid in resource.data.visibleTo);
      allow write: if false;
    }

    function isManagerOrAbove() {
      return isAdminOrOwner() || isManager();
    }

    // Resource balances and ledgers are changed only by trusted callable transactions.
    match /materialItems/{id} { allow read: if hasStaffProfile() || isOwner(); allow write: if false; }
    match /repairResources/{id} { allow read: if hasStaffProfile() || isOwner(); allow write: if false; }
    match /repairResourceConfirmations/{id} { allow read: if hasStaffProfile() || isOwner(); allow write: if false; }
    match /repairReworks/{id} { allow read: if hasStaffProfile() || isOwner(); allow write: if false; }
    match /materialValuations/{id} { allow read: if canUseCashflow(); allow write: if false; }
    match /resourceRates/{id} { allow read: if canUseCashflow(); allow write: if false; }
    match /resourceCosts/{id} { allow read: if canUseCashflow(); allow write: if false; }
    match /materialMovements/{id} { allow read: if canUseCashflow(); allow write: if false; }
    match /resourceRequests/{id} { allow read, write: if false; }

    function isAssignedMechanicAppointmentUpdate() {
      return resource.data.assignees is list
        && request.auth.uid in resource.data.assignees
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "assignees",
          "assigneeNames",
          "createdBy",
          "createdAt"
        ]);
    }

    function validOptionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function validSensorRegistry(data, sensorId) {
      return data.keys().hasOnly(["deviceId", "sensorId", "name", "lastSeenAt", "updatedAt"])
        && data.sensorId == sensorId
        && sensorId.matches('^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$')
        && (!("deviceId" in data) || data.deviceId is string)
        && (!("name" in data) || (data.name is string && data.name.size() <= 80))
        && (!("lastSeenAt" in data) || data.lastSeenAt is timestamp)
        && (!("updatedAt" in data) || data.updatedAt is timestamp);
    }

    function validSafeStaffFields(data) {
      return validOptionalString(data, "name")
        && validOptionalString(data, "email")
        && (!("fcmTokens" in data) || data.fcmTokens is list)
        && validOptionalString(data, "fcmUpdatedAt");
    }

    function validAdminPermissions(data) {
      return data is map
        && data.keys().hasOnly([
          "dashboard_financials",
          "reports_amounts",
          "pl_panel"
        ])
        && (!("dashboard_financials" in data) || data.dashboard_financials is bool)
        && (!("reports_amounts" in data) || data.reports_amounts is bool)
        && (!("pl_panel" in data) || data.pl_panel is bool);
    }

    function isSafeSelfStaffUpdate(userId) {
      return request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "email",
          "fcmTokens",
          "fcmUpdatedAt"
        ])
        && validSafeStaffFields(request.resource.data);
    }

    function isAdminStaffUpdate(userId) {
      return isAdmin()
        && request.auth.uid != userId
        && resource.data.role != "owner"
        && request.resource.data.role in ["admin", "manager", "mechanic"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "email",
          "role"
        ])
        && validSafeStaffFields(request.resource.data);
    }

    function isOwnerStaffUpdate(userId) {
      return isOwner()
        && request.auth.uid != userId
        && resource.data.role != "owner"
        && request.resource.data.role in ["admin", "manager", "mechanic"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "email",
          "role",
          "permissions"
        ])
        && validSafeStaffFields(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["permissions"])
          || (request.resource.data.role == "admin"
            && validAdminPermissions(request.resource.data.permissions)));
    }

    // Staff profiles are readable by coworkers because the CRM uses them for
    // assignees and names. New users always start as mechanics. Client code can
    // never create an owner or change its own role/permissions, including merge.
    match /staff/{userId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["name", "email", "role"])
        && request.resource.data.role == "mechanic"
        && validSafeStaffFields(request.resource.data);

      allow update: if isAuth()
        && (isSafeSelfStaffUpdate(userId)
          || isAdminStaffUpdate(userId)
          || isOwnerStaffUpdate(userId));

      // The current Staff UI has no delete operation.
      allow delete: if false;
    }

    // Mechanics use client documents to complete embedded repair tasks and the
    // voice workflow can create clients. Destructive client actions are manager+.
    match /clients/{clientId} {
      allow read, create, update: if isAuth();
      allow delete: if isAuth() && isManagerOrAbove();
    }

    // Standalone tasks are created/deleted by manager+, while assigned mechanics
    // update task progress.
    match /dailyPlans/{planId} {
      allow read: if isAuth() && (isManagerOrAbove() || resource.data.staffId == request.auth.uid);
      // A worker opening their first day must receive "no plan", not permission-denied.
      allow get: if isAuth() && resource == null
        && planId.matches(request.auth.uid + "_[0-9]{4}-[0-9]{2}-[0-9]{2}");
      allow write: if false;
      match /items/{itemId} {
        allow read: if isAuth() && (isManagerOrAbove()
          || (get(/databases/$(database)/documents/dailyPlans/$(planId)).data.staffId == request.auth.uid
            && get(/databases/$(database)/documents/dailyPlans/$(planId)).data.status == "published"));
        allow write: if false;
      }
      match /draftItems/{itemId} {
        allow read: if isAuth() && isManagerOrAbove();
        allow write: if false;
      }
    }
    match /dailyPlanNotifications/{notificationId} {
      allow read: if isAuth() && isManagerOrAbove();
      allow write: if false;
    }

    match /servicetasks/{taskId} {
      allow read: if isAuth();
      allow update: if isAuth()
        && (isManagerOrAbove()
          || (resource.data.assignees is list
            && request.auth.uid in resource.data.assignees
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "doneBy", "status", "workComment", "photos", "subtasks"
            ])
            && request.resource.data.get("doneBy", []) is list
            && request.resource.data.get("doneBy", []).removeAll([request.auth.uid])
              == resource.data.get("doneBy", []).removeAll([request.auth.uid])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
              || (request.resource.data.status == "done"
                && request.resource.data.get("doneBy", []).hasAll(resource.data.assignees))
              || (request.resource.data.status == "in_progress"
                && !request.resource.data.get("doneBy", []).hasAll(resource.data.assignees)))));
      allow create, delete: if isAuth() && isManagerOrAbove();
    }

    // The freezer UI exposes all mutations to manager/admin/owner only.
    match /freezers/{freezerId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && isManagerOrAbove();
    }

    function canUseCashflow() {
      return isOwner() || (isManagerOrAbove()
        && get(staffPath(request.auth.uid)).data.get("permissions", {}).get("pl_panel", true) != false);
    }

    function validCashflowDay(value) {
      return value is string && value >= "1900-01-01"
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10])).year() == int(value[0:4])
        && timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10])).month() == int(value[5:7])
        && timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10])).day() == int(value[8:10]);
    }

    function cashflowNotFuture(value) {
      return timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10]))
        <= (request.time + duration.value(10, "h")).date();
    }

    function validCashflowCategory(data) {
      return (data.kind == "income" && data.category in ["repairs", "rental", "subscription", "partsSale", "supplierRefund", "otherIncome", "equipmentSale", "loan", "ownerIn", "depositIn"])
        || (data.kind == "expense" && data.category in ["parts", "freon", "salary", "rent", "utilities", "transport", "contractor", "marketing", "tax", "bank", "overhead", "clientRefund", "equipment", "loanRepayment", "interest", "ownerOut", "depositOut"])
        || (data.kind == "transfer" && data.category == "transfer");
    }

    function validCashflowEntry(data) {
      return data.keys().hasAll(["kind", "status", "date", "accountId", "targetAccountId", "amountCents", "category", "counterparty", "comment", "sourceKey", "sourceType", "createdBy", "createdAt"])
        && data.keys().hasOnly(["kind", "status", "date", "accountId", "targetAccountId", "amountCents", "category", "counterparty", "comment", "sourceKey", "sourceType", "createdBy", "createdAt", "plannedDate", "postedBy", "postedAt", "voidReason", "voidedBy", "voidedAt"])
        && validCashflowCategory(data)
        && data.status in ["actual", "planned", "void"]
        && validCashflowDay(data.date)
        && (data.status != "actual" || cashflowNotFuture(data.date))
        && data.amountCents is int && data.amountCents > 0 && data.amountCents <= 1000000000000
        && data.accountId is string && data.accountId.size() > 0 && !data.accountId.matches('.*[/].*')
        && data.targetAccountId is string
        && exists(/databases/$(database)/documents/cashflowAccounts/$(data.accountId))
        && data.date >= get(/databases/$(database)/documents/cashflowAccounts/$(data.accountId)).data.openedOn
        && ((data.kind != "transfer" && data.targetAccountId == "")
          || (data.kind == "transfer" && data.targetAccountId != data.accountId
            && data.targetAccountId.size() > 0 && !data.targetAccountId.matches('.*[/].*')
            && exists(/databases/$(database)/documents/cashflowAccounts/$(data.targetAccountId))
            && data.date >= get(/databases/$(database)/documents/cashflowAccounts/$(data.targetAccountId)).data.openedOn))
        && data.counterparty is string && data.counterparty.size() <= 200
        && data.comment is string && data.comment.size() <= 1000
        && data.sourceKey is string && data.sourceKey.size() <= 300
        && data.sourceType in ["manual", "repair", "salary", "rent", "rental", "subscription"]
        && data.createdBy is string && data.createdAt is timestamp;
    }

    match /cashflowAccounts/{accountId} {
      allow read: if canUseCashflow();
      allow create: if canUseCashflow()
        && request.resource.data.keys().hasOnly(["name", "openedOn", "openingCents", "createdBy", "createdAt"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && validCashflowDay(request.resource.data.openedOn)
        && request.resource.data.openingCents is int && request.resource.data.openingCents >= -1000000000000 && request.resource.data.openingCents <= 1000000000000
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      // Opening balances are immutable once introduced; corrections are explicit money entries.
      allow update, delete: if false;
    }

    match /cashflowEntries/{entryId} {
      allow read: if canUseCashflow();
      allow create: if canUseCashflow() && validCashflowEntry(request.resource.data)
        && request.resource.data.status in ["actual", "planned"]
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(["plannedDate", "postedBy", "postedAt", "voidReason", "voidedBy", "voidedAt"]);
      allow update: if canUseCashflow() && validCashflowEntry(request.resource.data)
        && ((resource.data.status == "planned" && request.resource.data.status == "actual"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "date", "plannedDate", "postedBy", "postedAt"])
          && request.resource.data.plannedDate == resource.data.date
          && request.resource.data.postedBy == request.auth.uid && request.resource.data.postedAt == request.time)
        || (resource.data.status in ["actual", "planned"] && request.resource.data.status == "void"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "voidReason", "voidedBy", "voidedAt"])
          && request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 0 && request.resource.data.voidReason.size() <= 500
          && request.resource.data.voidedBy == request.auth.uid && request.resource.data.voidedAt == request.time));
      allow delete: if false;
    }

    // P&L is visible to manager/admin/owner. No other settings documents are
    // currently used by the client application.
    match /settings/finance {
      allow read, create, update: if isAuth() && isManagerOrAbove();
      allow delete: if false;
    }

    // Everyone who can open monitoring sees the same connection threshold;
    // manager+ may change it from the monitoring screen.
    match /settings/monitoring {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && isManagerOrAbove()
        && request.resource.data.keys().hasOnly([
          "offlineThresholdMinutes",
          "updatedAt"
        ])
        && request.resource.data.offlineThresholdMinutes is int
        && request.resource.data.offlineThresholdMinutes >= 1
        && request.resource.data.offlineThresholdMinutes <= 60;
      allow delete: if false;
    }

    match /settings/{document=**} {
      allow read, write: if false;
    }

    // Voice can create appointments for any authenticated worker. Mechanics may
    // update only appointments already assigned to them; manager+ can manage all.
    match /appointments/{docId} {
      allow read, create: if isAuth();
      allow update: if isAuth()
        && (isManagerOrAbove()
          || isAssignedMechanicAppointmentUpdate());
      allow delete: if isAuth() && isManagerOrAbove();
    }

    // Expenses are part of P&L. The UI creates and deletes them but has no update.
    match /expenses/{docId} {
      allow read, create, delete: if isAuth() && isManagerOrAbove();
      allow update: if false;
    }

    // Schedule editing is exposed only to owner/admin; everyone may view it.
    match /schedules/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && isAdminOrOwner();
    }

    // Walk-in repairs a mechanic opens on a car with no client yet. Any worker
    // may create, edit and delete one (matching how clients/{id} is open) —
    // assigning it to a client happens through the manager-only Отчёты screen.
    match /intakeRepairs/{docId} {
      allow read, create, update, delete: if isAuth();
    }

    // Device registry and readings are separate from clients and their embedded
    // repairs. Workers may view monitoring data; manager+ controls assignment.
    // Devices never authenticate to Firestore: only the HTTP Cloud Function,
    // running with Admin SDK privileges, writes state and packet history.
    match /monitoringDevices/{deviceId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && isManagerOrAbove();

      // Version history is written only by the authenticated callable backend.
      // CRM users read current rules; even manager+ cannot forge versions.
      match /temperatureRules/{ruleId} {
        allow read: if isAuth();
        allow write: if false;
      }

      // A name is CRM metadata only. The immutable technical sensorId is the
      // document id and is also written by ingestTelemetry through Admin SDK.
      match /sensors/{sensorId} {
        allow read: if isAuth();
        allow create: if isAuth() && isManagerOrAbove()
          && request.resource.data.keys().hasOnly(["sensorId", "name", "updatedAt"])
          && validSensorRegistry(request.resource.data, sensorId);
        allow update: if isAuth() && isManagerOrAbove()
          && request.resource.data.sensorId == resource.data.sensorId
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"])
          && validSensorRegistry(request.resource.data, sensorId);
        allow delete: if false;
      }
    }

    match /monitoringDeviceState/{deviceId} {
      allow read: if isAuth();
      allow write: if false;

      match /sensors/{sensorId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    // Controller diagnostics have their own current document and event history.
    // Browser clients can read them but never create, alter or delete either.
    match /monitoringControllerStatus/{controllerId} {
      allow read: if isAuth();
      allow write: if false;

      match /statusEvents/{statusId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    match /monitoringTelemetry/{deviceId} {
      allow read, write: if false;

      match /packets/{packetId} {
        allow read: if isAuth();
        allow write: if false;
      }

      // Read-only history projections. They are written exclusively by
      // ingestTelemetry and are deliberately separate from packet audit data.
      match /points/{pointId} {
        allow read: if isAuth();
        allow write: if false;
      }


      match /rollups/{rollupId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    // Alert lifecycle is backend-only. Every worker can see events, while the
    // browser may change only its own individual viewed timestamp.
    match /monitoringAlertEvents/{eventId} {
      allow read: if isAuth();
      allow update: if isAuth()
        && resource.data.viewedBy is map
        && request.resource.data.viewedBy is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedBy"])
        && request.resource.data.viewedBy.diff(resource.data.viewedBy).affectedKeys()
          .hasOnly([request.auth.uid])
        && request.resource.data.viewedBy.keys().hasAll([request.auth.uid])
        && request.resource.data.viewedBy[request.auth.uid] is timestamp;
      allow create, delete: if false;
    }

    // Credential hashes are backend-only. Even owner accounts use an audited
    // provisioning path rather than reading or editing these through the CRM.
    match /monitoringDeviceCredentials/{deviceId} {
      allow read, write: if false;
    }

    // Service-monitor diagnostics are a distinct server-owned channel. The
    // browser may observe controllers and their sanitized logs, but cannot
    // forge heartbeats, logs, or queued commands.
    match /serviceControllers/{controllerId} {
      allow read: if isAuth();
      allow write: if false;

      match /heartbeats/{heartbeatId} {
        allow read, write: if false;
      }

      match /statuses/{statusId} {
        allow read, write: if false;
      }
    }

    match /serviceControllerLogs/{controllerId} {
      allow read: if isAuth();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    match /serviceControllerCommands/{controllerId} {
      allow read, write: if false;

      match /commands/{commandId} {
        allow read: if isAuth() && isManagerOrAbove();
        allow write: if false;
      }
    }

    match /serviceControllerCommandResults/{controllerId} {
      allow read, write: if false;

      match /results/{commandId} {
        allow read: if isAuth() && isManagerOrAbove();
        allow write: if false;
      }
    }
  }
}
