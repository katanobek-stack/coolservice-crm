rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }

    function isAdminOrOwner() {
      return myRole() in ["admin", "owner"];
    }

    // ─── Staff ──────────────────────────────────────────────────────────────────
    // Запрещаем установку role: 'owner' через клиент — только через Admin SDK
    match /staff/{userId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.auth.uid == userId
        && !(request.resource.data.role == "owner");

      allow update: if isAuth()
        && (request.auth.uid == userId || isAdminOrOwner())
        && !(request.resource.data.role == "owner");

      allow delete: if isAuth() && isAdminOrOwner();
    }

    // ─── Clients ────────────────────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read, write: if isAuth();
    }

    // ─── Service Tasks ──────────────────────────────────────────────────────────
    match /servicetasks/{taskId} {
      allow read, write: if isAuth();
    }

    // ─── Freezers ───────────────────────────────────────────────────────────────
    match /freezers/{freezerId} {
      allow read, write: if isAuth();
    }

    // ─── Settings ───────────────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && isAdminOrOwner();
    }
  }
}
