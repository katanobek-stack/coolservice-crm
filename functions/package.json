{
  "name": "functions",
  "description": "Cloud Functions for coolservice-crm — Telegram notifications",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "generate:device-key": "npm run build && node scripts/generate-device-key.js",
    "seed:monitoring-demo": "node scripts/seed-monitoring-demo.js",
    "backfill:monitoring-read-model": "npm run build && node scripts/backfill-monitoring-read-model.js",
    "verify:monitoring-read-model": "npm run build && node scripts/verify-monitoring-read-model.js",
    "repair:monitoring-sensor-id": "npm run build && node scripts/repair-monitoring-sensor-id.js",
    "verify:monitoring-sensor-id-repair": "node scripts/verify-monitoring-sensor-id-repair.js",
    "test:read-model": "npm run build && node --test tests/telemetryReadModel.test.js",
    "test:emulator": "node --test tests/telemetry.emulator.test.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
